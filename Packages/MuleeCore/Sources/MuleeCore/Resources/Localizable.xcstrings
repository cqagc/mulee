    "TCP / UDP 端口须为 1–65535，上传限速不能小于 0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP / UDP 端口须为 1–65535，上传限速不能小于 0"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP / UDP ports must be 1–65535. Upload limit cannot be below 0."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP／UDP 連接埠須為 1–65535，上傳速度限制不能小於 0"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP / UDPポートは1〜65535、アップロード速度制限は0以上にしてください"
          }
        }
      }
    },
