          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to start the BT engine. Check whether the state directory is in use and its access permissions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BT 引擎無法啟動，請檢查狀態目錄是否被占用及存取權限"
