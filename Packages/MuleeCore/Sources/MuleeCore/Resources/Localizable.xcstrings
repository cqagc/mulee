    "BT 下载出错，请检查保存目录和网络连接": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BT 下载出错，请检查保存目录和网络连接"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BT download error. Check the download folder and network connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BT 下載出錯，請檢查儲存目錄和網路連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BTのダウンロードに問題があります。保存先とネットワーク接続を確認してください"
          }
        }
      }
    },
    "BT 下载参数有误": {
      "extractionState": "manual",
      "localizations": {
