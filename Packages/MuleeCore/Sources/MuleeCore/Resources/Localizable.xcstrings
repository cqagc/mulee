    "BT 引擎启动失败，请检查辅助程序的执行权限": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BT 引擎启动失败，请检查辅助程序的执行权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to start the BT engine. Check the helper’s execution permissions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BT 引擎無法啟動，請檢查輔助程式的執行權限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BTエンジンを起動できません。補助プログラムの実行権限を確認してください"
          }
        }
      }
    },
    "BT 引擎响应缺少结果": {
      "extractionState": "manual",
      "localizations": {
