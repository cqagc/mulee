    "用 ${applicationName} 新建下载": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ${applicationName} 新建下载"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a download in ${applicationName}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ${applicationName} 新增下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} でダウンロードを作成"
          }
        }
      }
    },
    "暂停 ${applicationName} 的全部下载": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停 ${applicationName} 的全部下载"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause all downloads in ${applicationName}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停 ${applicationName} 的所有下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} のすべてのダウンロードを一時停止"
          }
