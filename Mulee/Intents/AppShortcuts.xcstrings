      }
    },
    "继续 ${applicationName} 的全部下载": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续 ${applicationName} 的全部下载"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume all downloads in ${applicationName}"
