    "BT 和电驴共用；电驴上传越多，别人给你排队越靠前": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BT 和电驴共用；电驴上传越多，别人给你排队越靠前"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by BT and eD2k. Uploading more on eD2k can improve your queue position."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BT 和電驢共用；電驢上傳越多，別人給你的排隊順位越前面"
          }
        }
      }
